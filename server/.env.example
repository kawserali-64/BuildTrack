# BuildTrack Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas SRV connection string template
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/build-track?retryWrites=true&w=majority
CLIENT_URL=http://localhost:3000

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:5000

# First Admin Bootstrap — used ONLY by seedAdmin.ts at startup (NOT a public endpoint)
# Set these once to seed the initial Admin account; remove or rotate after first run.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPassword_AtLeast12Chars!
ADMIN_NAME=System Administrator
